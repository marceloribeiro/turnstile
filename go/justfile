# Turnstile Go data plane — builder-convention justfile.
# Loads .env so `just up` runs with your local config.
set dotenv-load := true

# Build everything (verifies the module; stdlib-only, no downloads needed).
install:
    go build ./...

# Run the data plane.
#   just up         → ports come from .env (TURNSTILE_LISTEN / _CONTROL_LISTEN), or
#                     the defaults :8080 / :8081
#   just up 8090    → data :8090, control :8091 (overrides .env; control is PORT+1)
# Run several side by side, each with its own ingest key (space ports by 2 so the
# control planes don't collide):
#   TURNSTILE_INGEST_KEY=ts_projectA just up 8080
#   TURNSTILE_INGEST_KEY=ts_projectB just up 8082
up port="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "{{port}}" ]; then
      export TURNSTILE_LISTEN=":{{port}}"
      export TURNSTILE_CONTROL_LISTEN="127.0.0.1:$(( {{port}} + 1 ))"
    fi
    go run ./cmd/turnstile

# Build a release binary into bin/.
build:
    go build -o bin/turnstile ./cmd/turnstile

# Run all tests (includes the proxy latency gate).
test:
    go test ./...

# Vet + format check (CI gate).
check:
    go vet ./...
    gofmt -l .

# Auto-format.
fmt:
    gofmt -w .

# Generate a random secret — use for TURNSTILE_SALT and TURNSTILE_CONTROL_TOKEN.
salt:
    @openssl rand -hex 32
