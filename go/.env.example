# Copy to .env for local dev:  cp .env.example .env
# Every value has a default in internal/config; only fill what you need.

# --- Data plane (the proxy) ---
# Listen address. `just up` reads this; `just up 8090` overrides it and sets the
# control plane to PORT+1. Run several instances by giving each a port + its own
# TURNSTILE_INGEST_KEY (see the telemetry section), and point each sample at the
# matching port via its TURNSTILE_BASE.
TURNSTILE_LISTEN=:8080
# Default provider upstream. Routing is request-based, so this is the fallback
# (OpenRouter), used for /api/v1/ and anything unmatched.
TURNSTILE_UPSTREAM=https://openrouter.ai
# Direct OpenAI adapter upstream. Claims the /v1/ surface (/v1/chat/completions
# and /v1/responses); point an OpenAI client's base URL at Turnstile to use it.
TURNSTILE_OPENAI_BASE=https://api.openai.com
# Direct Anthropic adapter upstream. Claims the Messages API (/v1/messages),
# matched ahead of OpenAI; point an Anthropic client's base URL at Turnstile.
TURNSTILE_ANTHROPIC_BASE=https://api.anthropic.com
# Direct Gemini adapter upstream. Claims the Generative Language API
# (/v1beta/models/{model}:generateContent); point a Gemini client at Turnstile.
TURNSTILE_GEMINI_BASE=https://generativelanguage.googleapis.com
# Fail-open (default) means a Turnstile fault never breaks your app. Set true to fail-closed.
TURNSTILE_FAIL_CLOSED=false
# HMAC salt for session/key fingerprints. Set a stable value to keep them comparable across restarts.
TURNSTILE_SALT=
# Per-request debug log (method, path, status, adapter, session, content-encoding, usage). Off by default.
TURNSTILE_DEBUG=false
# Cap (bytes) on the non-streaming response body buffered for metering. The client
# always receives the full body; only Turnstile's metering memory is bounded.
TURNSTILE_MAX_METER_BYTES=8388608

# --- Enforcement ---
TURNSTILE_SESSION_BUDGET_USD=0          # per-session hard ceiling; 0 = off
TURNSTILE_LOOP_ENABLED=true
TURNSTILE_LOOP_THRESHOLD=20             # identical calls in the window that trip a loop
TURNSTILE_LOOP_WINDOW=60s

# --- Control plane (dashboard data + manual kill) ---
TURNSTILE_CONTROL_LISTEN=127.0.0.1:8081
TURNSTILE_CONTROL_TOKEN=                # optional bearer auth; empty = localhost-only
# CORS allowed origin for the dashboard. Defaults to local dev; in production set
# your real dashboard origin (or "*" to allow any, not recommended).
TURNSTILE_DASHBOARD_ORIGIN=http://localhost:3000

# --- Telemetry to the platform (the API) — makes sessions show in the dashboard ---
# Disabled unless BOTH url and key are set. Without it, Turnstile still meters
# in-memory (visible on the control plane at :8081/v1/sessions); the ingest key is
# only what ships those aggregates to the platform/dashboard.
#
# How to get the ingest key (one-time):
#   1. Run the API + web app and sign in to the web app.
#   2. Open or create an organization → create a project → create a deployment.
#   3. Copy the deployment's ingest key (ts_...), shown once, and paste it below.
# Telemetry attributes to THAT deployment's organization — view that org to see it.
#
# Running several data planes? Give each its own key on the command line (it
# overrides this value):  TURNSTILE_INGEST_KEY=ts_otherproject just up 8090
TURNSTILE_INGEST_URL=http://localhost:8000/ingest/sessions
TURNSTILE_INGEST_KEY=
TURNSTILE_INGEST_INTERVAL=30s
