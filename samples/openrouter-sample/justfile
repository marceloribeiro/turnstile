# OpenRouter sample — talk to OpenRouter through Turnstile.
venv := "venv/bin"

default:
    @just --list

# Install the OpenAI SDK (OpenRouter is OpenAI-compatible) into a local venv.
install:
    test -d venv || python3 -m venv venv
    {{venv}}/pip install -q --upgrade pip
    {{venv}}/pip install -q -r requirements.txt

# Start the interactive REPL (Turnstile must be running on :8080).
console:
    {{venv}}/python chat.py
