# Your Anthropic API key (sk-ant-...). Turnstile passes it through and never stores it.
ANTHROPIC_API_KEY=

# Turnstile data plane base URL (the SDK posts to /v1/messages under it).
TURNSTILE_BASE=http://localhost:8080

# Optional overrides.
MODEL=claude-3-5-haiku-latest
# TURNSTILE_SESSION=anthropic-sample

# Seeing this session in the web DASHBOARD is configured elsewhere, NOT here:
# the ingest key lives in the DATA PLANE's config (go/.env), never in this sample.
# This sample needs only the provider key above. See the repo README section
# "Seeing it in the web dashboard" for that one-time setup.
