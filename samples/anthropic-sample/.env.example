# Your Anthropic API key (sk-ant-...). Turnstile passes it through and never stores it.
ANTHROPIC_API_KEY=

# Turnstile data plane base URL (the SDK posts to /v1/messages under it).
TURNSTILE_BASE=http://localhost:8080

# Optional overrides.
MODEL=claude-3-5-haiku-latest
# TURNSTILE_SESSION=anthropic-sample

# ── To see your session in the WEB DASHBOARD ─────────────────────────────────
# This sample does NOT use a Turnstile ingest key — only the provider key above.
# The ingest key belongs to the DATA PLANE (go/.env); it's what makes Turnstile
# ship your session to the platform so it shows up in the dashboard. Without it,
# Turnstile still meters in-memory (see http://localhost:8081/v1/sessions).
#
# How to get it (one-time):
#   1. Web app -> sign in -> open an organization -> create a project ->
#      create a deployment -> copy its ingest key (ts_...).
#   2. In go/.env set:
#        TURNSTILE_INGEST_URL=http://localhost:8000/ingest/sessions
#        TURNSTILE_INGEST_KEY=ts_...        # the key you just minted
#   3. Restart the data plane (just up) and view THAT org — your session appears
#      within one ingest interval.
