# Your OpenAI API key. Turnstile passes it straight through and never stores it.
OPENAI_API_KEY=

# The Turnstile data plane endpoint (host:PORT) — the sample appends /v1.
# Change the port to target a specific Go instance, e.g. http://localhost:8090
# for one you started with `just up 8090`.
TURNSTILE_BASE=http://localhost:8080

# Optional overrides.
MODEL=gpt-4o-mini
# TURNSTILE_SESSION=openai-sample

# Seeing this session in the web DASHBOARD is configured elsewhere, NOT here:
# the ingest key lives in the DATA PLANE's config (go/.env), never in this sample.
# This sample needs only the provider key above. See the repo README section
# "Seeing it in the web dashboard" for that one-time setup.
