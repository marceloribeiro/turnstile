# Copy to .env for local dev. Every value has a default in app/config.py.

# PostgreSQL (native, no Docker).
DB_USER=marcelo
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=turnstile_api_dev

# Auth (JWT). CHANGE JWT_SECRET in production.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Swagger /docs HTTP basic auth.
DOCS_USERNAME=turnstile
DOCS_PASSWORD=turnstile

# Comma-separated allowed CORS origins. Production MUST set the real dashboard
# origin(s); "*" allows all callers and should not be used in production.
CORS_ORIGINS=http://localhost:3000

# Redis — powers live dashboard updates (WebSocket pub/sub). Use `just docker-up`
# to run it locally, or a native redis. Needed only for the live-update feature.
REDIS_URL=redis://localhost:6379/0

# Web app base URL — used to build invitation accept links.
APP_BASE_URL=http://localhost:3000

# Postmark — emails organization invitations. Blank token = email disabled
# (the invitation is still created with its token).
POSTMARK_API_TOKEN=
POSTMARK_FROM=no-reply@turnstile.dev
POSTMARK_MESSAGE_STREAM=outbound
